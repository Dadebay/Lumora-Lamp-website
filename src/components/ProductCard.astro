---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { productImage } from "../lib/images.ts";
import { formatPriceFrom } from "../lib/price.ts";
import { productHref, type Locale } from "../i18n/config.ts";
import { t } from "../i18n/ui.ts";
import { site } from "../../site.config.ts";

interface Props {
  product: CollectionEntry<"products">;
  lang: Locale;
  /** İlk ekranda görünen kartlar: LCP için eager yüklenir. */
  priority?: boolean;
  index?: number;
}
const { product, lang, priority = false, index = 0 } = Astro.props;
const d = product.data;
const ui = t(lang);

const off = productImage(d.images.off);
const on = productImage(d.images.on);

const price = formatPriceFrom(d.price, d.priceFrom, lang);
---
<article
  class="card reveal group"
  style={`--delay:${Math.min(index, 8) * 60}ms`}
>
  <div class="relative">
  <a href={productHref(lang, product.id)} class="block">
    <!-- Işık kapalı ve açık kareler üst üste; geçişi CSS yapıyor -->
    <div class="lamp card-media aspect-4/5 w-full">
      <Image
        src={off}
        alt={d.images.alt[lang]}
        widths={[400, 700, 1000]}
        sizes="(min-width:1280px) 22vw, (min-width:768px) 30vw, 46vw"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
      <Image
        class="lamp-on"
        src={on}
        alt=""
        aria-hidden="true"
        widths={[400, 700, 1000]}
        sizes="(min-width:1280px) 22vw, (min-width:768px) 30vw, 46vw"
        loading={priority ? "eager" : "lazy"}
        decoding="async"
      />
    </div>
  </a>

  {site.commerceMode === "shop" && (
    <button
      type="button"
      data-add-to-cart={product.id}
      aria-label={`${ui.product.addToCart}: ${d.title[lang]}`}
      title={ui.product.addToCart}
      class="absolute bottom-3 right-3 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[var(--page-line)] bg-[color-mix(in_srgb,var(--page-bg)_82%,transparent)] text-[var(--page-fg)] shadow-sm backdrop-blur-md transition-[transform,background-color,color,border-color] duration-300 hover:scale-105 hover:border-[var(--color-glow)] data-[added=true]:border-[var(--color-glow)] data-[added=true]:text-[var(--color-glow)]"
    >
      <span data-label-default class="flex">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="h-[18px] w-[18px]" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
      </span>
      <span data-label-added hidden class="flex">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]" aria-hidden="true">
          <path d="m5 12.5 4.5 4.5L19 7.5" />
        </svg>
      </span>
    </button>
  )}
  </div>

  <a href={productHref(lang, product.id)} class="block">
    <div class="mt-3 flex items-start justify-between gap-3">
      <h3 class="text-sm leading-snug">
        {d.title[lang]}
        {d.isNew && (
          <sup class="ml-1 align-super text-[9px] uppercase tracking-wider text-[var(--color-glow)]">{ui.product.new}</sup>
        )}
      </h3>
    </div>
    <p class="mt-0.5 text-sm opacity-60">
      {price}
    </p>
  </a>
</article>

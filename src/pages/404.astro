---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found" description="The page you're looking for doesn't exist." lang="en" noindex>
  <div class="mx-auto max-w-xl px-5 py-32 text-center md:px-8">
    <h1 class="display text-5xl">404</h1>
    <p class="mt-4 text-sm opacity-65">The page you're looking for isn't here.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-[var(--page-fg)] px-6 py-3 text-sm text-[var(--page-bg)] transition-[background-color,color,opacity] duration-300 hover:opacity-85">
      Home
    </a>
  </div>
</Layout>

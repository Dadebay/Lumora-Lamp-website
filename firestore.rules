rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // İletişim/teklif formu: ziyaretçi yalnızca yeni kayıt OLUŞTURABİLİR.
    // Okuma, güncelleme, silme kapalı — mesajları sadece Firebase konsolundan görürsün.
    match /contactRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'product', 'message', 'lang', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'lang', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+') && request.resource.data.email.size() <= 200
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 60))
        && (!('product' in request.resource.data)
            || (request.resource.data.product is string && request.resource.data.product.size() <= 500))
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.lang in ['en', 'tr', 'ru']
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
